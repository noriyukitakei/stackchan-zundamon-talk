# cp .env.example .env して値を書き換える（.env は git に入れない）

# Azure OpenAI（必須。未設定だと会話はできず、/say や /zundamon だけ使える）
AZURE_OPENAI_ENDPOINT=https://xxx.openai.azure.com
AZURE_OPENAI_API_KEY=<キー>
# ② 返事を作る Chat モデルのデプロイ名（gpt-4o-mini など、推論しない速いモデルがおすすめ）
AZURE_OPENAI_DEPLOYMENT=<デプロイ名>
AZURE_OPENAI_API_VERSION=2024-10-21

# ① 音声認識モデルのデプロイ名（速さ重視で gpt-4o-mini-transcribe。精度重視なら gpt-4o-transcribe）
AZURE_OPENAI_STT_DEPLOYMENT=gpt-4o-mini-transcribe
AZURE_OPENAI_STT_API_VERSION=2025-03-01-preview

# ③ VOICEVOX
VOICEVOX_URL=http://127.0.0.1:50021
ZUNDAMON_STYLE=ノーマル
ZUNDAMON_SPEED=1.0

# 話し終わりの判定（うまく区切れないときに調整する）
VAD_RMS_THRESHOLD=600
VAD_SILENCE_MS=800
